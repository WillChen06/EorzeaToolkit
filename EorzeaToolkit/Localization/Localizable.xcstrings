{
  "sourceLanguage" : "en",
  "strings" : {
    "%@・%@" : {
      "comment" : "A label displaying the gathering's job and method, followed by its level. The first argument is the gathering's job. The second argument is the gathering's method. The third argument is the gathering's level.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@・%2$@"
          }
        }
      }
    },
    "%lld" : {
      "comment" : "A badge displaying the number of total gathering locations. The number is dynamic and updates as the user views more or fewer locations.",
      "isCommentAutoGenerated" : true
    },
    "•" : {
      "comment" : "A bullet point.",
      "isCommentAutoGenerated" : true
    },
    "×%lld" : {
      "comment" : "A label displaying the number of items needed for a recipe. The argument is the amount of the ingredient needed.",
      "isCommentAutoGenerated" : true
    },
